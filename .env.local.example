# ============================================================
# 5 Hazaar Tak — Environment Variables
# ============================================================
#
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Get your Supabase credentials at:
#   https://supabase.com/dashboard → Your Project → Settings → API
# ============================================================

# Supabase (Public — exposed to browser for client-side queries)
# These are safe to expose: Row Level Security controls data access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Also supports NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY if using Supabase publishable key format
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase (Server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Administrative Notifications & Access Control
ADMIN_EMAILS=admin@5000shop.pk

# Storefront Customer Support & Operations
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
