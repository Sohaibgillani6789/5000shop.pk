# ============================================================
# 5 Hazaar Tak — Environment Variables
# ============================================================
#
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Get your Supabase credentials at:
#   https://supabase.com/dashboard → Your Project → Settings → API
# ============================================================

# Supabase (Public — exposed to browser for client-side queries)
# These are safe to expose: Row Level Security controls data access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

