# ============================================================
# 5 Hazaar Tak (5000shop.pk) — Environment Variables Contract
# ============================================================
#
# Copy this file to .env.local:
#   cp .env.local.example .env.local
#
# ------------------------------------------------------------
# 1. PUBLIC (BROWSER-SAFE) VARIABLES
# ------------------------------------------------------------
# Inlined by Next.js at build time into client bundles.
# Never place database passwords or service role keys here!

# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key (public access controlled by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# (Optional fallback if your Supabase project uses publishable keys):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical site URL (used for metadataBase, canonical links, sitemap, robots, OpenGraph)
# In production, must be an absolute HTTPS URL (e.g. https://5000shop.pk).
# In local development, defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp customer support & dispatch number (digits only, country code without "+")
# Pakistan international format: 923XXXXXXXXX (defaults to 923000000000 if unset)
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# ------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY AIR-GAPPED — NEVER EXPOSE)
# ------------------------------------------------------------
# Guarded by `import 'server-only'` in src/lib/env/server.ts.
# Next.js will refuse to build if any client component imports these.

# Supabase Service-Role Secret (bypasses Row-Level Security for server operations)
# NEVER commit, log, or send to the browser!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Comma-separated list of lowercased emails authorized for /admin access
# Used exclusively to authorize authenticated Supabase user sessions (never as an auth bypass).
ADMIN_EMAILS=admin@5000shop.pk,operations@5000shop.pk

# ------------------------------------------------------------
# 3. OPTIONAL AUTOMATED E2E / SMOKE CREDENTIALS (DEV / STAGING)
# ------------------------------------------------------------
# Used only by test scripts (e.g. scripts/smoke-e2e.ts, Playwright)
# Never populate these on production environments!
# E2E_ADMIN_EMAIL=admin@5000shop.pk
# E2E_ADMIN_PASSWORD=your-test-password
# E2E_NONADMIN_EMAIL=shopper@example.com
# E2E_NONADMIN_PASSWORD=your-test-password
