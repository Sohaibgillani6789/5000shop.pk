# ============================================================
# 5 Hazaar Tak — Environment Variables
# ============================================================
#
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Get your Sanity credentials at: https://www.sanity.io/manage
# ============================================================

# Sanity CMS (Public — exposed to browser for Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-26

# Sanity Webhook Secret (Private — server-side only)
# Generate a random string and set it in both:
# 1. This file
# 2. Your Sanity webhook configuration at sanity.io/manage
SANITY_WEBHOOK_SECRET=your-webhook-secret-here
